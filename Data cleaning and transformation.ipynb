   "source": [
    "# creating a separate  file for data manipulation\n",
    "df_raw = pd.read_csv( r\"C:\\Users\\ugniu\\PycharmProjects\\Unsupervised  learning\\Data\\Raw\\mental-heath-in-tech-2016_20161114.csv\")\n",
    "\n",
    "df = df_raw.copy()\n"
   ],
   "id": "f61830b8a2bbf95e",
   "outputs": [],
   "execution_count": 87
  },
  {
   "metadata": {
