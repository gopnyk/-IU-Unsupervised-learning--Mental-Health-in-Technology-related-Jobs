    "\n",
    "    # Non-binary / trans / genderqueer / other explicit non-binary identities\n",
    "    \"non-binary\": \"Non-binary\", \"Nonbinary\": \"Non-binary\", \"Agender\": \"Non-binary\",\n",
    "    \"Bigender\": \"Non-binary\", \"Female assigned at birth \": \"Non-binary\",\n",
